{
  "name": "memento-sticker-journal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src worker",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "invite:create": "node --env-file-if-exists=.dev.vars scripts/create-invite.mjs",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "fabric": "^7.4.0",
    "lucide-react": "1.30.0",
    "matter-js": "^0.20.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260804.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
